{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social Drops Campaign",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "clientId",
    "objective",
    "weeks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "weeks": {
      "type": "array",
      "minItems": 1
    }
  }
}