{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Social Drop",
  "type":"object",
  "required":["id","type","message","platforms"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "type":{"enum":["post","reel","story","carousel","sales_pitch","event","fundraiser","testimonial","call_to_action"]},
    "message":{"type":"string","minLength":1},
    "platforms":{"type":"array","minItems":1,"items":{"enum":["instagram","facebook","linkedin","tiktok","youtube","x"]}},
    "scheduledAt":{"type":["string","null"]},
    "media":{"type":["string","object","null"]},
    "cta":{"type":["object","null"],"properties":{"label":{"type":"string"},"url":{"type":"string"}}}
  }
}
