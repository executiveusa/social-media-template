{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social Drops Strategy",
  "type": "object",
  "required": [
    "clientId",
    "objective",
    "framework",
    "weeks"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "minLength": 1
    },
    "campaignId": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "framework": {
      "type": "array",
      "const": [
        "learn",
        "see",
        "experience"
      ]
    },
    "weeks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    }
  }
}